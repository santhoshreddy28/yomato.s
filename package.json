{
  "name": "hosteleats-hostel-food-ordering",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Minimalist hostel food ordering app (web + Android via Capacitor)",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "images": "python3 scripts/split-collage.py",
    "android:sync": "npm run build && npx cap sync android",
    "apk": "bash scripts/build-apk.sh"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0"
  }
}
